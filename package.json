{
  "name": "drupal-blade",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "webpack --config webpack.production.config.js",
    "watch": "webpack --watch --config webpack.dev.config.js",
    "preview": "browser-sync start --server \"web/themes/custom/proton_systems\" --startPath \"preview.html\" --files \"web/themes/custom/proton_systems/assets/dist/*.css, web/themes/custom/proton_systems/assets/dist/*.js, web/themes/custom/proton_systems/preview.html\""
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "browser-sync": "^3.0.4",
    "browser-sync-webpack-plugin": "^2.4.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "sass": "^1.103.1",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "packageManager": "pnpm@11.1.3",
  "dependencies": {
    "swiper": "^14.2.0"
  }
}
