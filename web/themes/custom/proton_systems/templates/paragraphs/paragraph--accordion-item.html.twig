{# LINK: assets/sass/paragraphs/_paragraph-accordion.scss

   One item of an "accordion" paragraph. paragraph.id.value uniquely IDs the
   button/panel pair even when several accordions land on the same page.
#}
{% if paragraph.published %}
    {% set button_id = 'paragraph-accordion-item-' ~ paragraph.id.value ~ '-button' %}
    {% set panel_id = 'paragraph-accordion-item-' ~ paragraph.id.value ~ '-panel' %}

    <div class="paragraph-accordion__item">
        <h3 class="paragraph-accordion__item-heading">
            <button type="button" id="{{ button_id }}" class="paragraph-accordion__item-trigger" aria-expanded="false" aria-controls="{{ panel_id }}">
                <span>{{ paragraph.field_title.value }}</span>
                <span class="paragraph-accordion__sign" aria-hidden="true"></span>
            </button>
        </h3>

        <div id="{{ panel_id }}" class="paragraph-accordion__item-panel" role="region" aria-labelledby="{{ button_id }}">
            <div class="paragraph-accordion__item-content content-text">
                {{ paragraph.field_description.processed }}
            </div>
        </div>
    </div>
{% endif %}
