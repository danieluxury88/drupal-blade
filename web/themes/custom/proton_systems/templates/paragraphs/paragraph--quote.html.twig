{# LINK: assets/sass/paragraphs/_paragraph-quote.scss #}
{% if paragraph.published %}
    {% set image_uri = paragraph.field_person_picture.entity.uri.value %}

    <div class="paragraph-quote__wrapper">
        <div class="u-generic-wrapper">
            <div class="u-generic-wrapper-margin">
                <div class="paragraph-quote">
                    <div class="paragraph-quote__content">
                        {% if image_uri %}
                            <div class="paragraph-quote__photo">
                                <img src="{{ file_url(image_uri) }}" alt="{{ paragraph.field_person_picture.alt ?: (paragraph.field_person_name.value ~ ' photo') }}">
                            </div>
                        {% endif %}

                        <div class="paragraph-quote__text-content">
                            <blockquote class="paragraph-quote__quote">
                                &ldquo;{{ paragraph.field_quote.value }}&rdquo;
                            </blockquote>

                            <div class="paragraph-quote__attribution">
                                <div class="paragraph-quote__person-name">{{ paragraph.field_person_name.value }}</div>
                                {% if paragraph.field_person_title.value %}
                                    <div class="paragraph-quote__person-title">{{ paragraph.field_person_title.value }}</div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}
