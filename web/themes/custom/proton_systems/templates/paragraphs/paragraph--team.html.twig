{% if paragraph.published %}
    <div class="paragraph-team__wrapper">
        <div class="u-generic-wrapper">
            <div class="u-generic-wrapper-margin">
                {% if paragraph.field_title.value %}
                    <h2 class="paragraph-team__title">{{ paragraph.field_title.value }}</h2>
                {% endif %}

                <div class="paragraph-team__items">
                    {{ content.field_members }}
                </div>
            </div>
        </div>
    </div>
{% endif %}
