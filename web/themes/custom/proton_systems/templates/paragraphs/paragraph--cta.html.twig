{# LINK: assets/sass/paragraphs/_paragraph-cta.scss #}
{% if paragraph.published %}
    {% set link_url = paragraph.field_link.0.getUrl.toString %}
    {% set link_title = paragraph.field_link.0.title %}

    <div class="paragraph-cta__wrapper">
        <div class="u-generic-wrapper">
            <div class="u-generic-wrapper-margin">
                <div class="paragraph-cta paragraph-cta--default">
                    <div class="paragraph-cta__content">
                        {% if paragraph.field_title.value %}
                            <h2 class="paragraph-cta__title">{{ paragraph.field_title.value }}</h2>
                        {% endif %}

                        {% if paragraph.field_description.value %}
                            <div class="paragraph-cta__text content-text">
                                {{ paragraph.field_description.processed }}
                            </div>
                        {% endif %}

                        {% if link_url and link_title %}
                            <div class="paragraph-cta__buttons">
                                <a href="{{ link_url }}" class="button">{{ link_title }}</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}
