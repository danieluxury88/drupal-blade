{# LINK: assets/sass/paragraphs/_paragraph-hero.scss
   LINK: assets/js/hero-slider.js
   LINK: templates/paragraphs/paragraph--hero-slide.html.twig
   LINK: templates/fields/field--field-slides.html.twig

   field_slides is an entity_reference_revisions field to "hero_slide"
   paragraphs; field--field-slides.html.twig strips Drupal's default field
   wrapper so each rendered slide can sit directly in .swiper-wrapper.
#}
{% if paragraph.published %}
    <div class="paragraph-hero__wrapper">
        <div class="paragraph-hero swiper js-hero-slider">
            <div class="swiper-wrapper">
                {{ content.field_slides }}
            </div>
        </div>
    </div>
{% endif %}
